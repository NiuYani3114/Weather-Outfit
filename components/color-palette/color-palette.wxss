/* 组件最外层容器 */
.palette-container {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

/* 头部：名称和主题 */
.palette-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.palette-name {
  font-size: 16px;
  font-weight: bold;
  color: #333333;
}

.palette-theme {
  font-size: 12px;
  color: #4a90e2;
  background-color: #eef5fe;
  padding: 2px 8px;
  border-radius: 10px;
}

/* 色块区域 */
.palette-colors {
  display: flex;
  flex-direction: row;
  height: 60px;
  border-radius: 8px;
  overflow: hidden; /* 让圆角生效 */
  margin-bottom: 12px;
}

.color-block {
  flex: 1; /* 每个色块平分宽度 */
  height: 100%;
}

/* 无配色时的占位 */
.empty-color {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
  color: #999999;
  font-size: 14px;
}

/* 底部描述文字 */
.palette-desc {
  font-size: 13px;
  color: #666666;
  line-height: 1.5;
}