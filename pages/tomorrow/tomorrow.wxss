/* ========== 页面基础 ========== */
.page-container {
  background-color: var(--bg);
  color: var(--text-primary);
  min-height: 100vh;
  padding-bottom: 40rpx;
  padding-top: 40rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

/* ========== 穿搭推荐区 ========== */
.outfit-card {
  position: relative;
  z-index: 3;
  margin: -80rpx 24rpx 0 24rpx;
  background-color: var(--card-bg);
  border-radius: var(--radius-xl, 32rpx);
  padding: 40rpx 30rpx;
  box-shadow: var(--shadow-lg);
  transition: all 0.3s ease;
}

.outfit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.outfit-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 横滑列表 */
.outfit-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.outfit-list {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding-bottom: 10rpx;
}

.outfit-item-wrapper {
  display: inline-block;
  width: 140rpx;
  flex-shrink: 0;
}

/* ========== 标签 ========== */
.tag-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.tag-blue { background: var(--tag-blue-bg); color: var(--tag-blue-text); }
.tag-green { background: var(--tag-green-bg); color: var(--tag-green-text); }

/* ========== 底部通用卡片区 ========== */
.tomorrow-card {
  margin: 0 24rpx;
  background-color: var(--card-bg);
  border-radius: var(--radius-xl, 32rpx);
  padding: 36rpx 30rpx;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
}

.tomorrow-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.tomorrow-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

/* ========== 未来5天横滑条（修改了这里） ========== */
.forecast-scroll {
  width: 100%;
  white-space: nowrap;
}

.forecast-list {
  display: flex;
  flex-direction: row;
  gap: 20rpx; /* 加大间距，不挤了 */
}

.forecast-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border-radius: 24rpx;
  padding: 20rpx 30rpx; /* 加大内边距，看着更饱满 */
  min-width: 120rpx; /* 最小宽度拉宽 */
  box-sizing: border-box;
}

.forecast-date {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.forecast-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.forecast-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.forecast-temp {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
}

/* ========== 色彩灵感区 ========== */
.color-inspiration {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 24rpx;
}

.inspiration-left {
  display: flex;
  flex-direction: column;
}

.inspiration-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.inspiration-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.inspiration-colors {
  display: flex;
  gap: 10rpx;
}

.color-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}