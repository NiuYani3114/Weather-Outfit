/* 收藏页样式 - 成员5（保留前面日夜模式，合并后面功能样式） */
.page-container {
  background-color: var(--bg) !important;
  color: var(--text-primary);
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx 40rpx 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 32rpx 0;
  color: var(--text-primary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  border: 1px solid var(--border);
}

/* 性别分类 tab */
.gender-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 6rpx;
  background: var(--card-bg);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
}

.gender-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 26rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.gender-tab.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  font-weight: 600;
}

/* 卡片列表 */
.fav-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fav-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.fav-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.fav-style {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.fav-date {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.fav-items {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.fav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fav-icon {
  font-size: 40rpx;
  color: var(--text-primary);
}

.fav-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.fav-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border);
}

.fav-temp {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.fav-delete {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 20rpx;
  background: rgba(255, 107, 107, 0.1);
  border-radius: 24rpx;
}