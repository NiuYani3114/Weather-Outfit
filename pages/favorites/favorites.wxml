<!-- 收藏页 - 成员5（保留前面日夜模式，合并后面功能） -->
<view class="page-container {{isLightMode ? 'light-mode' : ''}}">
  <view class="page-title">我的收藏</view>

  <!-- 性别分类 tab -->
  <view class="gender-tabs" wx:if="{{allFavorites.length > 0}}">
    <view class="gender-tab {{activeGender === 'all' ? 'active' : ''}}"
          bindtap="switchGenderTab" data-gender="all">全部 {{counts.all}}</view>
    <view class="gender-tab {{activeGender === 'female' ? 'active' : ''}}"
          bindtap="switchGenderTab" data-gender="female">女生 {{counts.female}}</view>
    <view class="gender-tab {{activeGender === 'male' ? 'active' : ''}}"
          bindtap="switchGenderTab" data-gender="male">男生 {{counts.male}}</view>
  </view>

  <!-- 全量为空 -->
  <view wx:if="{{allFavorites.length === 0}}" class="empty-state">
    <text class="empty-icon">🤍</text>
    <text>还没有收藏任何搭配</text>
    <view class="empty-sub" bindtap="goHome">去首页逛逛</view>
  </view>

  <!-- 当前分类为空 -->
  <view wx:elif="{{favorites.length === 0}}" class="empty-state">
    <text class="empty-icon">🔍</text>
    <text>该分类下暂无收藏</text>
  </view>

  <!-- 收藏列表 -->
  <view wx:else class="fav-list">
    <view class="fav-card"
          wx:for="{{favorites}}"
          wx:key="favId"
          bindtap="goDetail"
          data-item="{{item}}">
      <view class="fav-header">
        <text class="fav-style">{{item.style || '今日穿搭'}}</text>
        <text class="fav-date">{{item.favTimeStr}}</text>
      </view>

      <view class="fav-items">
        <view class="fav-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="type">
          <text class="fav-icon">{{it.icon}}</text>
          <text class="fav-name">{{it.name}}</text>
        </view>
      </view>

      <view class="fav-footer">
        <text class="fav-temp">{{item.temp}}°时收藏</text>
        <view class="fav-delete" catchtap="deleteFav" data-item="{{item}}">删除</view>
      </view>
    </view>
  </view>
</view>