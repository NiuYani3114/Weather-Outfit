<view class="page-container {{isLightMode ? 'light-mode' : ''}}">
  <view class="card">
    <view class="card-title">个人设置</view>
    <view class="setting-row" bindtap="onChangeGender">
      <text class="row-label">性别</text>
      <text class="row-value">{{genderText}} <text class="arrow">▾</text></text>
    </view>
    <view class="setting-row" bindtap="onChangeBodyType">
      <text class="row-label">体质偏好</text>
      <text class="row-value">{{bodyTypeText}} <text class="arrow">▾</text></text>
    </view>
    <view class="row-tip">体质会影响穿搭引擎的厚度推荐</view>
  </view>

  <view class="card">
    <view class="setting-row">
      <text class="row-label">记录穿搭历史</text>
      <view class="custom-switch {{recordHistory ? 'switch-on' : 'switch-off'}}" bindtap="toggleHistory">
        <view class="switch-handle"></view>
      </view>
    </view>
    
    <view class="setting-row">
      <text class="row-label">夜间模式</text>
      <view class="custom-switch {{!isLightMode ? 'switch-on' : 'switch-off'}}" bindtap="onToggleTheme">
        <view class="switch-handle"></view>
      </view>
    </view>
  </view>

  <!-- 危险按钮 -->
  <view class="danger-zone">
    <button class="danger-btn" bindtap="onClearData">清空收藏与历史数据</button>
  </view>
</view>