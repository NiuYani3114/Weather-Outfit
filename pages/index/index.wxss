/* ========== 主题变量覆盖 ========== */
.page-container.light-mode {
  --bg: #f5f7fa;
  --card-bg: #ffffff;
  --text-primary: #1a1a2e;
  --text-secondary: #666666;
  --border: #e8e8e8;
}

/* ========== 页面基础 ========== */
.page-container {
  background-color: var(--bg);
  color: var(--text-primary);
  min-height: 100vh;
  padding-bottom: 40rpx;
  padding-top: 40rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

/* ========== 今日穿搭区 ========== */
.outfit-card {
  position: relative;
  z-index: 3;
  margin: -80rpx 24rpx 0 24rpx;
  background-color: var(--card-bg);
  border-radius: var(--radius-xl, 32rpx);
  padding: 40rpx 30rpx;
  box-shadow: var(--shadow-lg);
  transition: all 0.3s ease;
}

.outfit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.outfit-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.outfit-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* ========== 标签 ========== */
.tag-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.tag-blue { background: var(--tag-blue-bg); color: var(--tag-blue-text); }
.tag-green { background: var(--tag-green-bg); color: var(--tag-green-text); }
.tag-orange { background: var(--tag-orange-bg); color: var(--tag-orange-text); }

/* ========== 按钮 ========== */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md, 16rpx);
  font-size: 28rpx;
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
}

.btn-outline.active {
  border-color: var(--danger);
  color: var(--danger);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #fff;
  font-weight: bold;
}

/* ========== 明日穿搭预览 ========== */
.tomorrow-card {
  margin: 24rpx 24rpx 0 24rpx;
  background-color: var(--card-bg);
  border-radius: var(--radius-xl, 32rpx);
  padding: 36rpx 30rpx;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
}

.tomorrow-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.tomorrow-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.tomorrow-weather {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.tomorrow-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tomorrow-icon {
  font-size: 60rpx;
}

.tomorrow-tip {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ===== 新增：个人信息弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
}

.setup-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: var(--card-bg);
  border-radius: var(--radius-lg, 24rpx);
  padding: 40rpx 32rpx;
  z-index: 1000;
  box-shadow: var(--shadow-lg);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.radio-group {
  display: flex;
  gap: 40rpx;
}

.radio-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.body-type-group {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.body-type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md, 16rpx);
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.body-type-item.active {
  background: rgba(131, 150, 235, 0.15);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: bold;
}

.save-btn {
  width: 100% !important;
  margin-top: 24rpx;
  border-radius: var(--radius-xl, 32rpx) !important;
}