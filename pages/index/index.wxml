<view class="page-container {{isLightMode ? 'light-mode' : ''}}">

<!-- 顶部天气区 -->
<weather-card
  city="{{city}}"
  temp="{{currentTemp}}"
  feelTemp="{{feelTemp}}"
  weather="{{weatherText}}"
  icon="{{weatherIcon}}"
  dateText="{{dateText}}"
  warning="{{warningText}}"
  isLightMode="{{isLightMode}}"
/>

<!-- 今日穿搭区 -->
<view class="outfit-card">
  <view class="outfit-header">
    <view class="outfit-title">今日穿搭</view>
    <view class="gender-switch">
      <view
        class="gender-btn {{gender === 'female' ? 'active' : ''}}"
        bindtap="onGenderChange"
        data-gender="female"
      >女生</view>
      <view
        class="gender-btn {{gender === 'male' ? 'active' : ''}}"
        bindtap="onGenderChange"
        data-gender="male"
      >男生</view>
    </view>
  </view>

  <!-- 临时用 view（等成员2组件好了换成 outfit-item） -->
  <view class="outfit-list">
    <view
      class="outfit-item-card"
      wx:for="{{outfitItems}}"
      wx:key="id"
      style="background: {{item.bgColor}};"
    >
      <text class="outfit-icon">{{item.icon}}</text>
      <text class="outfit-name">{{item.name}}</text>
    </view>
  </view>

  <view class="tag-row" wx:if="{{styleTags.length > 0}}">
    <view
      class="tag {{index === 0 ? 'tag-blue' : index === 1 ? 'tag-green' : 'tag-orange'}}"
      wx:for="{{styleTags}}"
      wx:key="*this"
    >{{item}}</view>
  </view>

  <view class="action-row">
    <view
      class="btn btn-outline {{isFav ? 'active' : ''}}"
      bindtap="onToggleFavorite"
    >
      {{isFav ? '❤️ 已收藏' : '🤍 收藏'}}
    </view>
    <view class="btn btn-primary" bindtap="goOutfits">
      查看更多搭配
    </view>
  </view>
</view>

<!-- 明日穿搭预览 -->
<view class="tomorrow-card" bindtap="goTomorrow">
  <view class="tomorrow-header">
    <view class="tomorrow-title">明日穿搭预览</view>
    <view class="tomorrow-weather">{{tomorrow.date}} {{tomorrow.tempMin}}°~{{tomorrow.tempMax}}°</view>
  </view>
  <view class="tomorrow-body">
    <text class="tomorrow-icon">👗</text>
    <text class="tomorrow-tip">{{tomorrow.tip}}</text>
  </view>
</view>

<!-- 设置入口 -->
<view class="settings-entry" bindtap="goSettings">
  ⚙️ 设置
</view>

</view>