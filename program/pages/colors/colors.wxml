<!-- 色彩搭配 - 成员5 -->
<view class="container">
  <view class="page-title">色彩搭配灵感</view>
  
  <!-- 当前推荐 -->
  <view wx:if="{{recommend.length > 0}}" class="section">
    <view class="section-title">今日推荐</view>
    <color-palette 
      wx:for="{{recommend}}" 
      wx:key="name"
      name="{{item.name}}"
      theme="{{item.theme}}"
      colors="{{item.colors}}"
      desc="{{item.desc}}"
      bind:select="onSelectPalette"
    />
  </view>
  
  <!-- 全部配色 -->
  <view class="section">
    <view class="section-title">全部配色方案</view>
    <color-palette 
      wx:for="{{allPalettes}}" 
      wx:key="name"
      name="{{item.name}}"
      theme="{{item.theme}}"
      colors="{{item.colors}}"
      desc="{{item.desc}}"
      bind:select="onSelectPalette"
    />
  </view>
</view>