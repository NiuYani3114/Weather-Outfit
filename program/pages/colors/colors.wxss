/* 色彩搭配样式 - 成员5 */
.page-container {
  background-color: var(--bg-color);
  color: var(--text-primary);
  min-height: 100vh;
  transition: all 0.3s ease;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 32rpx 0;
  color: var(--text-primary);
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
