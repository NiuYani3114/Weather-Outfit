/* 多套搭配样式 - 成员5 */
.page-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 32rpx 0;
}

.temp-badge {
  font-size: 24rpx;
  color: var(--primary);
  background: #e8eaf6;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: white;
  color: #666;
  font-size: 26rpx;
  white-space: nowrap;
  box-shadow: var(--shadow-sm);
}

.filter-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.outfit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.outfit-card-item {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.outfit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.outfit-style {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.outfit-temp {
  font-size: 24rpx;
  color: var(--primary);
  background: #e8eaf6;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.outfit-items-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.mini-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mini-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.mini-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.color-tag {
  font-size: 22rpx;
  color: var(--text-light);
  background: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}