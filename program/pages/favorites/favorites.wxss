/* 收藏页样式 - 成员5 */
.page-container {
  background-color: var(--bg-color);
  color: var(--text-primary);
  min-height: 100vh;
  transition: all 0.3s ease;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  margin: 32rpx 0;
  color: var(--text-primary);
}

.empty-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
  color: var(--text-secondary);
}

.fav-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fav-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}

.fav-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.fav-style {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.fav-date {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.fav-items {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.fav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fav-icon {
  font-size: 40rpx;
  color: var(--text-primary);
}

.fav-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.fav-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--divider-color);
}

.fav-temp {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.fav-delete {
  font-size: 24rpx;
  color: #ff6b6b;
  padding: 8rpx 20rpx;
}
