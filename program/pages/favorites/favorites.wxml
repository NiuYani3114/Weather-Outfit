<!-- 收藏页 - 成员5 -->
<view class="container">
  <view class="page-title">我的收藏</view>
  
  <view wx:if="{{favorites.length === 0}}" class="empty-state">
    <text class="empty-icon">🤍</text>
    <text>还没有收藏任何搭配</text>
    <view class="empty-sub" bindtap="goHome">去首页逛逛</view>
  </view>
  
  <view wx:else class="fav-list">
    <view class="fav-card" wx:for="{{favorites}}" wx:key="favId" bindtap="goDetail" data-item="{{item}}">
      <view class="fav-header">
        <text class="fav-style">{{item.style}}</text>
        <text class="fav-date">{{item.favTimeStr}}</text>
      </view>
      <view class="fav-items">
        <view class="fav-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="type">
          <text class="fav-icon">{{it.icon}}</text>
          <text class="fav-name">{{it.name}}</text>
        </view>
      </view>
      <view class="fav-footer">
        <text class="fav-temp">{{item.temp}}°时收藏</text>
        <text class="fav-delete" bindtap="deleteFav" data-favid="{{item.favId}}" data-item="{{item}}">删除</text>
      </view>
    </view>
  </view>
</view>