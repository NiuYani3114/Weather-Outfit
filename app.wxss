/* ================= 全局主题变量 ================= */
/* 默认：夜间模式 */
page {
  --bg-color: #1c2029;
  --card-bg: #2a2f3a;
  --text-primary: #e8eaed;
  --text-secondary: #9aa0a6;
  --divider-color: #12151c;
}

/* 日间模式 */
.page-container.light-mode {
  --bg-color: #ffffff;
  --card-bg: #f4f6f8;
  --text-primary: #1a1a1a;
  --text-secondary: #666666;
  --divider-color: #e8eaed;
}

/* 全局基础样式 */
page {
  background-color: var(--bg-color);
  color: var(--text-primary);
  transition: all 0.3s ease;
}