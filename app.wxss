/* ========== 全局变量 ========== */
page {
  --primary: #8396eb;
  --secondary: #9064bc;
  
  /* 【夜间模式】默认 */
  --bg: #2b2f3a;          /* 页面底色 */
  --card-bg: #353945;     /* 卡片底色 */
  --text-primary: #ffffff;
  --text-secondary: #b0b0b0;
  --text-light: #808080;
  --border: #444855;
  
  --tag-blue-bg: rgba(92, 107, 192, 0.2); --tag-blue-text: #8c9eff;
  --tag-green-bg: rgba(0, 137, 123, 0.2); --tag-green-text: #4db6ac;
  --tag-orange-bg: rgba(245, 124, 0, 0.2); --tag-orange-text: #ffb74d;
  --tag-pink-bg: rgba(233, 30, 99, 0.2); --tag-pink-text: #f06292;

  --radius-sm: 8rpx; --radius-md: 16rpx; --radius-lg: 24rpx; --radius-xl: 32rpx;
  --space-xs: 8rpx; --space-sm: 16rpx; --space-md: 24rpx; --space-lg: 32rpx; --space-xl: 48rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--text-primary);
}

/* 【日间模式】 */
.page-container.light-mode {
  --bg: #f5f7fa;
  --card-bg: #ffffff;
  --text-primary: #1a1a2e;
  --text-secondary: #666666;
  --text-light: #999999;
  --border: #e8e8e8;

  --tag-blue-bg: #e8eaf6; --tag-blue-text: #5c6bc0;
  --tag-green-bg: #e0f2f1; --tag-green-text: #00897b;
  --tag-orange-bg: #fff3e0; --tag-orange-text: #f57c00;
  --tag-pink-bg: #fce4ec; --tag-pink-text: #e91e63;

  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* ========== 全局基础 ========== */
/* 保留页面基础，但绝对不碰你页面的卡片 */
.page-container {
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  background-color: var(--bg);
  color: var(--text-primary);
  /* 保持这一行，它是堵住黑条的神器，稍微垫高一像素不露缝 */
  padding-top: 1px !important; 
}