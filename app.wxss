/* ========== 全局变量 ========== */
page {
  /* 主色 */
  --primary: #8396eb;
  --primary-dark: #7982dc;
  --secondary: #9064bc;

  /* 背景 */
  --bg: #f5f7fa;
  --card-bg: #ffffff;

  /* 文字 */
  --text-primary: #1a1a2e;
  --text-secondary: #666666;
  --text-light: #999999;

  /* 功能色 */
  --border: #e8e8e8;
  --warning: #f5a623;
  --danger: #ff6b6b;
  --success: #52c41a;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--text-primary);
}

/* ========== 通用布局 ========== */
.container {
  padding: 0 var(--space-lg);
  padding-bottom: 160rpx; /* 给底部 tabBar 留空间 */
}

.flex { display: flex; }
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ========== 卡片通用 ========== */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-md);
  margin-bottom: var(--space-md);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-md);
}

/* ========== 按钮 ========== */
.btn {
  padding: 20rpx 40rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
}

.btn-outline {
  background: white;
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
}

/* ========== 标签 ========== */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-blue { background: #e8eaf6; color: #5c6bc0; }
.tag-green { background: #e0f2f1; color: #00897b; }
.tag-orange { background: #fff3e0; color: #f57c00; }
.tag-pink { background: #fce4ec; color: #e91e63; }

/* ========== 加载状态 ========== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--text-light);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* ========== 工具类 ========== */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.divider {
  height: 1rpx;
  background: var(--border);
  margin: var(--space-md) 0;
}

/* ========== 动画 ========== */
.fade-in {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.heart-beat {
  animation: heartBeat 0.3s ease;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}